# CDUTETC ACM 事务助手 · 配置模板
# 复制为 .env 后按需填写；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 取值说明见 README「配置（环境变量）」。留空的项使用代码默认值。

# ============================================================
# 一、必填（缺失时 check_config() 直接抛错，机器人不启动）
# ============================================================
# OneBot/NapCat 正向 WebSocket 地址
ACM_ONEBOT_WS_URL=ws://127.0.0.1:3001
# 大模型 API Key（OpenAI 兼容接口）
ACM_LLM_API_KEY=

# ============================================================
# 二、连接与身份
# ============================================================
# OneBot 鉴权 token（与 NapCat 配置一致；未开启留空）
ACM_ONEBOT_TOKEN=
# 机器人自身 QQ 号；留空则使用 OneBot 事件的 self_id
ACM_BOT_QQ=

# ============================================================
# 三、群与角色权限（默认全拒绝，务必填写）
# ============================================================
# 允许服务的群号，逗号分隔。留空 = 不服务任何群
ACM_ALLOWED_GROUPS=
# 超管 QQ 号，逗号分隔。可 /修正、审批发布、私聊管理命令
ACM_SUPER_ADMIN=
# 老师 QQ 号，逗号分隔。可发布比赛、管课程/FAQ/征集
ACM_TEACHER_WHITELIST=
# 超管私聊执行管理命令时作用的群；留空取 ALLOWED_GROUPS 排序首个
ACM_ADMIN_GROUP=
# 发布命令前缀
ACM_PUBLISH_CMD=发布
# 未授权群被 @ 或发命令时，是否回一句带群号的提示（1=开启，便于取号后 /加群）
ACM_NOTICE_UNAUTHORIZED_GROUP=1
# 同一未授权群的提示最小间隔（秒），防刷屏
ACM_NOTICE_UNAUTHORIZED_INTERVAL=60
# 群内是否必须 @机器人 才响应（默认 1）。设为 0 则单独发 /帮助 等命令也会响应
ACM_GROUP_REQUIRE_AT=1
# 说明：上面的群/老师白名单是「配置文件基线」。超管还可用 /加群 /加老师
# 在运行时动态添加，立即生效无需重启，结果存在数据库，与基线取并集。
# 超管白名单不支持运行时添加，只能在此处配置。

# ============================================================
# 四、功能开关
# ============================================================
# 群主动消息与定时提醒总开关（1=启用）
ACM_GROUP_ACTIVE_MESSAGES_ENABLED=1
# 老师发布后先私聊超管确认，同意才入库并通知群（1=启用）
ACM_PUBLISH_CONFIRM_ENABLED=1
# 公共来源自动抓取（0=关闭，仅允许 /抓取一次 手动触发）
ACM_AUTO_FETCH_ENABLED=0
# 自动周赛（1=启用）
ACM_WEEKLY_CONTEST_ENABLED=1
ACM_WEEKLY_CONTEST_WEEKDAY=6
ACM_WEEKLY_CONTEST_START=19:00
ACM_WEEKLY_CONTEST_END=21:00
ACM_WEEKLY_CONTEST_TEMPLATE=ACM 周赛（本周）

# ============================================================
# 五、大模型
# ============================================================
ACM_LLM_BASE_URL=https://api.deepseek.com/v1
ACM_LLM_MODEL=deepseek-chat
ACM_LLM_MAX_INPUT_CHARS=6000
ACM_LLM_MAX_OUTPUT_TOKENS=2000
ACM_LLM_CONCURRENCY=2

# ============================================================
# 六、链接抓取（SSRF 与资源限制）
# ============================================================
# 可抓取域名白名单，逗号分隔，小写。强烈建议配置
ACM_FETCH_ALLOWED_DOMAINS=
ACM_FETCH_MAX_BYTES=1000000
ACM_FETCH_MAX_REDIRECTS=3
ACM_FETCH_TIMEOUT=10
ACM_FETCH_CONCURRENCY=2
# 旧配置兼容保留，模型输入上限由 ACM_LLM_MAX_INPUT_CHARS 控制
ACM_FETCH_TEXT_LIMIT=3000
ACM_FETCH_MIN_INTERVAL_MINUTES=60

# ============================================================
# 七、定时提醒
# ============================================================
ACM_REMIND_CHECK_INTERVAL_MINUTES=30
# 旧单节点回退值；未配置 ACM_REMIND_OFFSET_HOURS 时生效
ACM_REMIND_BEFORE_HOURS=24
# 多节点提前提醒（小时，逗号分隔，支持小数）
# 24,1 = 提前 24 小时和 1 小时各提醒一次；10 分钟可写 0.167
# 不建独立定时器，按周期扫描判定，占用与比赛数量无关
ACM_REMIND_OFFSET_HOURS=24,1

# ============================================================
# 八、问答防护（五层）
# ============================================================
# 1) 话题范围硬限制
ACM_QA_TOPIC_GATE_ENABLED=1
ACM_QA_OFFTOPIC_REPLY=我只回答与 ACM 集训队、比赛、训练相关的问题哦~
# 2) 敏感内容拦截（输入+输出）
ACM_QA_SENSITIVE_GATE_ENABLED=1
ACM_QA_SENSITIVE_REPLY=这个问题我不方便回答，请换个话题~
ACM_QA_SENSITIVE_EXTRA_WORDS=
# 3) 用户权限：留空 = 全群可问（推荐）；填写后仅白名单成员可问
ACM_QA_WHITELIST_ENABLED=1
ACM_QA_WHITELIST=
ACM_QA_BLACKLIST=
ACM_QA_WHITELIST_REPLY=这个群暂时只允许指定成员提问哦~
# 4) 频率防刷
ACM_QA_RATE_LIMIT_ENABLED=1
ACM_QA_RATE_LIMIT_SECONDS=10
ACM_QA_RATE_LIMIT_MAX_CALLS=3
ACM_QA_RATE_LIMIT_REPLY=你问得太快啦，稍等几秒再问吧~
# 5) 输出过滤
ACM_QA_OUTPUT_MAX_LENGTH=800
ACM_QA_OUTPUT_MAX_LINK_LENGTH=60
ACM_QA_OUTPUT_FILTERED_REPLY=这条回复内容不合规，已被过滤，换个问法试试~
# 6) 算法话题拦截（省 token）
ACM_QA_PROBLEM_GATE_ENABLED=1
ACM_QA_PROBLEM_REPLY=算法相关的题解、思路和概念科普，机器人这边就不展开啦。想啃题就自己多想想，或把代码贴给队友讨论，等集训课问老师收获更大！
ACM_QA_PROBLEM_EXTRA_WORDS=
# 7) 普通成员只答已录入内容，未命中转人工（不调模型）
ACM_QA_MEMBER_KB_ONLY=1
ACM_QA_MEMBER_NO_MATCH_REPLY=这个问题我暂时查不到确切答案，已经帮你转给老师啦，稍等一下~
ACM_QA_KB_MATCH_MIN_SCORE=0.34

# ============================================================
# 九、本地数据与调试
# ============================================================
# SQLite 路径；留空取项目目录下 contests.db
ACM_DB_PATH=
# 采集白名单时可临时设 1 记录群号/QQ号/消息前50字，采完务必关闭
ACM_DEBUG_LOG_IDENTITY=0
