# NapCat OneBot 11 正向 WebSocket：端口和 token 与 NapCat 配置保持一致。
ACM_ONEBOT_WS_URL=ws://127.0.0.1:3001
ACM_ONEBOT_TOKEN=

# 机器人 QQ 号；留空时使用 OneBot 事件 self_id。
ACM_BOT_QQ=
# 允许服务的 QQ 群号，逗号分隔；留空时忽略所有群消息。
ACM_ALLOWED_GROUPS=
# 老师和超管均填写 QQ 号，逗号分隔。首次发布需要老师白名单。
ACM_TEACHER_WHITELIST=
ACM_SUPER_ADMIN=

# 将真实 key 填入本地 .env，不修改本样例。
ACM_LLM_API_KEY=
ACM_LLM_BASE_URL=https://api.deepseek.com/v1
ACM_LLM_MODEL=deepseek-chat
ACM_LLM_MAX_INPUT_CHARS=6000
ACM_LLM_MAX_OUTPUT_TOKENS=2000
ACM_LLM_MAX_RESPONSE_BYTES=262144
ACM_LLM_CONCURRENCY=2
# 全文提取最多 8 段、总等待 120 秒为 llm.py 常量，没有对应环境开关。

# 默认开启主动通知和提醒。设为 0 时暂停投递，群命令回复仍可使用。
ACM_GROUP_ACTIVE_MESSAGES_ENABLED=1
ACM_PUBLISH_CMD=发布
ACM_REMIND_CHECK_INTERVAL_MINUTES=30
ACM_REMIND_BEFORE_HOURS=24

# 默认周赛周日 19:00-21:00，生成任务按提醒配置提前安排。
ACM_WEEKLY_CONTEST_ENABLED=1
ACM_WEEKLY_CONTEST_WEEKDAY=6
ACM_WEEKLY_CONTEST_START=19:00
ACM_WEEKLY_CONTEST_END=21:00
ACM_WEEKLY_CONTEST_TEMPLATE=ACM 周赛（本周）

# 公共来源自动抓取默认关闭；0/1 开关。
ACM_AUTO_FETCH_ENABLED=0
ACM_FETCH_MIN_INTERVAL_MINUTES=60
ACM_FETCH_ALLOWED_DOMAINS=
ACM_FETCH_MAX_BYTES=1000000
ACM_FETCH_MAX_REDIRECTS=3
ACM_FETCH_TIMEOUT=10
ACM_FETCH_CONCURRENCY=2
# 此旧变量兼容保留，不再用于截断完整提取正文。
ACM_FETCH_TEXT_LIMIT=3000

# 从仓库根目录启动时使用此相对路径；也可改为稳定绝对路径。
ACM_DB_PATH=./contests.db
